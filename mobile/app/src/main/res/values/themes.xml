<resources>
    <color name="kaze_splash">#080810</color>

    <style name="Theme.Kaze" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/kaze_splash</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <style name="Theme.Kaze.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/kaze_splash</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.Kaze</item>
    </style>

    <style name="Theme.Kaze.Player" parent="Theme.Kaze">
        <item name="android:windowBackground">@android:color/black</item>
    </style>
</resources>

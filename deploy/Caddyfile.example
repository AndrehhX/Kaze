# Caddyfile de referencia para la VPS. El hash del panel NO va en el repo:
# generalo con `caddy hash-password` en la VPS.
{
    # Cloudflare habla con la VPS por 80 (SSL "Flexible") o 443 (SSL "Full"). Sin redirecciones
    # automaticas HTTP->HTTPS para no crear bucles con el modo Flexible.
    auto_https disable_redirects
}

(orunei_routes) {
    # Web (Next.js standalone, servicio orunei-web)
    @web host www.orunei.sbs orunei.sbs vps.orunei.sbs
    handle @web {
        reverse_proxy 127.0.0.1:3000 {
            # El visitante llega por HTTPS a Cloudflare; Next necesita saberlo.
            header_up X-Forwarded-Proto https
        }
    }

    @panel host panel.orunei.sbs
    handle @panel {
        basicauth {
            orunei <HASH_DE_caddy_hash-password>
        }
        reverse_proxy 127.0.0.1:8080
    }

    @resolver host resolver.orunei.sbs
    handle @resolver {
        reverse_proxy 127.0.0.1:3001
    }

    handle {
        respond "Not found" 404
    }
}

:80 {
    import orunei_routes
}

# HTTPS de origen con certificado propio. Cloudflare en modo SSL "Full" lo acepta.
# Para "Full (strict)" cambia `tls internal` por un Origin Certificate de Cloudflare:
#   tls /etc/caddy/origin.pem /etc/caddy/origin.key
www.orunei.sbs, orunei.sbs, vps.orunei.sbs, panel.orunei.sbs, resolver.orunei.sbs {
    tls internal
    import orunei_routes
}

[Unit]
Description=Orunei web (Next.js standalone)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=orunei
Group=orunei
WorkingDirectory=/opt/orunei-web/current
EnvironmentFile=/opt/orunei-web/shared/.env
Environment=NODE_ENV=production
Environment=PORT=3000
Environment=HOSTNAME=127.0.0.1
Environment=NODE_OPTIONS=--max-old-space-size=512
ExecStart=/usr/bin/node server.js
Restart=always
RestartSec=3
# Limites de memoria para no ahogar al resolver, Redis ni al bot en una VPS de 2 GB.
MemoryHigh=600M
MemoryMax=800M
# Endurecimiento basico
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/orunei-web

[Install]
WantedBy=multi-user.target

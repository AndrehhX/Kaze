    "clsx": "^2.1.1",
    "hls.js": "^1.7.4",
    "lucide-react": "^1.64.0",
    "motion": "^14.8.0",
    "next": "16.4.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
